{{pageTitle p.title}}
<h1 class="pano-fb-title">{{p.heading}}</h1>
<form class="pano-fb-form" data-pano-endpoint="{{endpoint}}" data-pano-busy="{{t.common.working}}">
  <p class="pano-fb-lead" data-pano-hide-on-done>{{p.lead}}</p>
  <input type="hidden" name="token" value="{{token}}">
  <label class="pano-fb-field" data-pano-hide-on-done>
    <span>{{p.username}}</span>
    <input type="text" name="newUsername" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="16" required>
  </label>
  <p class="pano-fb-message" data-pano-message role="alert" hidden></p>
  <button type="submit" class="pano-fb-button" data-pano-hide-on-done>{{p.button}}</button>
  <div class="pano-fb-done" data-pano-done hidden>
    <p class="pano-fb-lead">{{p.done}}</p>
    {{#if loginUrl}}<a class="pano-fb-button" href="{{loginUrl}}">{{t.common.signIn}}</a>{{/if}}
  </div>
</form>
